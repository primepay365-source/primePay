<?xml version="1.0" encoding="UTF-8"?>
<!--
  PrimePay database migrations (Oracle Database): one changelog, one change set per SQL script.
  Flow: db.changelog-master.xml -> change set NNN -> scripts/NNN-name.sql -> Oracle.
  All SQL (tables, indexes, seed rows) lives in scripts/; rollbacks in scripts/rollback/. Liquibase records each
  change set in DATABASECHANGELOG and serialises runs with DATABASECHANGELOGLOCK.

  To change the schema: add scripts/022-name.sql (+ scripts/rollback/022-name-rollback.sql) and a change set with
  id="022" at the end of this file. Never edit a script or change set that has already run on a shared database.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
    logicalFilePath="db/changelog/db.changelog-master.xml">

    <!-- 001: scripts/001-create-agent-account-table.sql -->
    <changeSet id="001" author="primepay">
        <sqlFile path="scripts/001-create-agent-account-table.sql" relativeToChangelogFile="true" splitStatements="true" endDelimiter=";" stripComments="false" encoding="UTF-8"/>
        <rollback>
            <sqlFile path="scripts/rollback/001-create-agent-account-table-rollback.sql" relativeToChangelogFile="true" splitStatements="true" endDelimiter=";" stripComments="false" encoding="UTF-8"/>
        </rollback>
    </changeSet>

