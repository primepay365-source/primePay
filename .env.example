# Copy to .env and fill in. Never commit .env.
# Generate secrets, for example in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))

# --- Oracle (docker compose) ---
ORACLE_SYS_PASSWORD=
ORACLE_APP_USER=primepay
ORACLE_APP_PASSWORD=

# --- API ---
# Base64 of at least 32 random bytes (HS256 signing key)
JWT_SECRET_BASE64=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Development-only admin login (local Docker Oracle only; keep false anywhere shared) ---
DEV_BOOTSTRAP_ENABLED=true
DEV_ADMIN_USERNAME=admin@primepay.local
# Leave empty to generate a random password on every start (printed once in the API log).
DEV_ADMIN_PASSWORD=

# --- Frontend (only needed when the API is not proxied at /api) ---
VITE_API_BASE_URL=/api/v1
